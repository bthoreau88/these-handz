[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/CharacterSelect.gd" id="1_select"]

[node name="CharacterSelect" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_select")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.13, 0.12, 0.18, 1)

[node name="Layout" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 60.0
offset_top = 40.0
offset_right = -60.0
offset_bottom = -40.0
theme_override_constants/separation = 24
alignment = 1

[node name="Title" type="Label" parent="Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "THESE HANDZ"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "TAP A FIGHTER FOR PLAYER 1"
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 4
columns = 4
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16

[node name="Buttons" type="HBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 24

[node name="ModeButton" type="Button" parent="Layout/Buttons"]
custom_minimum_size = Vector2(280, 80)
layout_mode = 2
text = "P2: CPU (NORMAL)"

[node name="FightButton" type="Button" parent="Layout/Buttons"]
custom_minimum_size = Vector2(260, 80)
layout_mode = 2
disabled = true
text = "FIGHT!"

[node name="ResetButton" type="Button" parent="Layout/Buttons"]
custom_minimum_size = Vector2(180, 80)
layout_mode = 2
text = "RESET"

[connection signal="pressed" from="Layout/Buttons/ModeButton" to="." method="_on_mode_pressed"]
[connection signal="pressed" from="Layout/Buttons/FightButton" to="." method="_on_fight_pressed"]
[connection signal="pressed" from="Layout/Buttons/ResetButton" to="." method="_on_reset_pressed"]
